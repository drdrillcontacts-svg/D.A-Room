#include <windows.h>
#include "resource.h"

IDI_INSTALLER_ICON ICON "@INSTALLER_ICON_PATH@"
IDR_WELCOME_PNG    RCDATA "@INSTALLER_WELCOME_PATH@"
IDR_BASE_PNG       RCDATA "@INSTALLER_BASE_PATH@"
IDR_PAYLOAD_BIN    RCDATA "@INSTALLER_PAYLOAD_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "D.A Production\0"
            VALUE "FileDescription",  "D.A Production - D.A Room VST3 Installer\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "DA_Production_Installer.exe\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 D.A Production\0"
            VALUE "OriginalFilename", "D.A Production Installer.exe\0"
            VALUE "ProductName",      "D.A Room VST3 (64-bit)\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
